# Required: MongoDB connection string for the GreenDrop database.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/greendrop?retryWrites=true&w=majority

# Optional: API port and allowed browser origins (comma-separated).
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:5000

# Required only when creating ADMIN accounts.
ADMIN_SECRET_KEY=replace-with-a-long-random-secret
